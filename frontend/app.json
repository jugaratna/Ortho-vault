{
  "expo": {
    "name": "OrthoVault",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.surgicalvault.uexgsr",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach X-rays and scans to patient records",
        "NSCameraUsageDescription": "Capture clinical photos for patient records",
        "NSFaceIDUsageDescription": "Unlock patient records with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.surgicalvault.uexgsr",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach X-rays and scans to patient records",
          "cameraPermission": "Capture clinical photos for patient records"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock patient records with Face ID"
        }
      ],
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
